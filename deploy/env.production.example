# Production settings. On the server:
#   cp deploy/env.production.example .env && chmod 600 .env && nano .env
# Generate every secret below with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# (letters, digits, '-' and '_' only — the DB init script rejects anything else)
# Never commit .env. Keep a copy somewhere safe: losing LOG_HASH_KEY/JWT_SECRET_KEY is recoverable,
# losing MARIADB_ROOT_PASSWORD makes backups/admin painful.
#
# APP_ENV, DB_HOST, DB_PORT, REDIS_URL and MEDIA_ROOT are fixed in docker-compose.yml.

APP_NAME="SpecGrid API"
DEBUG=false
CORS_ORIGINS=[]

# --- MariaDB (container "db"; created on first start by deploy/mariadb/init/01-accounts.sh)
MARIADB_ROOT_PASSWORD=
DB_NAME=specgrid
DB_USER=specgrid_app
DB_PASSWORD=
DB_MIGRATION_USER=specgrid_migrator
DB_MIGRATION_PASSWORD=

# --- secrets (64 chars recommended: token_urlsafe(48))
JWT_SECRET_KEY=
# Set once and never change it: activity logs store HMAC(LOG_HASH_KEY, ip).
LOG_HASH_KEY=

# --- public URL of uploaded photos (nginx serves /media/ from ./data/media)
MEDIA_BASE_URL=https://YOUR_DOMAIN/media

# --- Kakao Maps JavaScript key. Register https://YOUR_DOMAIN in Kakao Developers
#     (앱 > 플랫폼 키 > JavaScript 키 > JavaScript SDK 도메인) or maps stay hidden.
KAKAO_JS_KEY=
