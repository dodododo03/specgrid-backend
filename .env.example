# Copy to .env and fill in real values. Never commit .env.
APP_NAME=SpecGrid API
APP_ENV=local
DEBUG=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# MariaDB (this PC: MariaDB 12.3 listens on 3307; 3306 is a separate MySQL 9.5)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=specgrid
# Runtime account: SELECT/INSERT/UPDATE/DELETE only
DB_USER=specgrid_app
DB_PASSWORD=change-me
# Migration account (Alembic only): DDL privileges
DB_MIGRATION_USER=specgrid_migrator
DB_MIGRATION_PASSWORD=change-me-too

REDIS_URL=redis://localhost:6379/0

# JWT (HS256). Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Media storage (local disk for now; swap backend for S3 later)
MEDIA_ROOT=media
MEDIA_BASE_URL=http://localhost:8000/media
